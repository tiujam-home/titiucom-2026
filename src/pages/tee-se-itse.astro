---
/**
 * Omat tee-se-itse-projektit. Content from titiu.com/product-design.
 * Linked from the "Tutustutaan" section (AboutSheet).
 */
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import Sheet from '../components/portfolio/Sheet.astro';
import ContactSheet from '../components/portfolio/ContactSheet.astro';
import Fancybox from '../components/portfolio/Fancybox.astro';

const img = (f: string) => `/img/tee-se-itse/${f}`;

type Photo = { file: string; alt: string; width: number; height: number };
type Project = {
  id: string;
  name: string;
  version?: string;
  photos: Photo[];
  before?: string[];
  listIntro?: string;
  list?: string[];
  after?: string[];
};

const projects: Project[] = [
  {
    id: 'projektorihylly',
    name: 'Projektori­hylly',
    version: '1.0',
    photos: [{ file: 'projector-shelf.webp', alt: 'Titiu Rajannon projektorihylly 1.0', width: 1600, height: 1745 }],
  },
  {
    id: 'takki-ja-hattuteline',
    name: 'Takki- ja hattuteline',
    version: '1.0',
    photos: [
      { file: 'coat-rack.webp', alt: 'Titiu Rajannon takkiteline 1.0', width: 1000, height: 990 },
      { file: 'hat-rack.webp', alt: 'Titiu Rajannon hattuteline 1.0', width: 764, height: 1380 },
    ],
    before: [
      'Nykyisessä asunnossamme on pieni eteinen. Siis <em>tosi</em> pieni. Aluksi ajattelin, että pärjään sen kanssa, koska meillä ei ole muutenkaan kovin paljon tavaraa. Lopulta hankaluus alkoi kuitenkin ärsyttää. Tarvitsin jotain, joka täyttäisi tietyt kriteerit:',
    ],
    list: [
      'Sen piti mahtua tilaan, joka oli enintään 13 cm syvä ja 55 cm leveä.',
      'Ei laatikoita tai kaappeja hatuille, huiveille ja hanskoille. Halusin niiden kaikkien olevan näkyvillä.',
      'Henkarit vapaaehtoisia. En pidä henkareista. Mieheni pitää.',
    ],
    after: [
      'Olen tosi tyytyväinen lopputulokseen ja olen jo suunnitellut seuraavan version, jonka voisi asentaa lapsille sopivalle korkeudelle. Huivien ja lapasten tunkeminen kuminauhojen väliin ja sieltä pois on todella tyydyttävää ja helppoa. Tykkään myös siitä, että kosteahkot vaatteet kuivuvat avoimessa tilassa ihan hyvin. Mitään ei huku, koska näet <em>kaiken</em>, ja sivuille ja yläosaan mahtuu pienempiä tavaroita.',
    ],
  },
  {
    id: 'sohva',
    name: 'Sohva',
    photos: [{ file: 'diy-sofa.webp', alt: 'Titiu Rajannon sohva', width: 1000, height: 635 }],
    before: [
      'En usko rakentavani uutta sohvaa ihan heti, koska sen tekeminen oli tosi työlästä (lähinnä kaiken ompelun ja nappien paikoilleen laittamisen takia). Seuraavaan sohvaan on jo suunnitteilla uusia ominaisuuksia (vaikka en siis rakenna sitä ihan heti), mutta taidan kutsua sitä nimellä ”Parempi sohva” enkä ”Sohva 2.0”. Niin moni asia muuttuu, että lopputulos on liian erilainen samaan versiosarjaan.',
      'Suunnitteluperiaate pysyy kuitenkin samana:',
    ],
    list: [
      'Rakenna sohva, jonka saa helposti muutettua parisängyksi… tai kahdeksi erilliseksi sängyksi.',
      'Tee siitä kevyt ja purettava, jotta muuttomiesten on helppo kantaa se ;)',
      'Rakenna se niin, että se kestää maailman loppuun asti (tai neljä sen päällä hyppivää lasta).',
    ],
  },
  {
    id: 'rauhalan-tila',
    name: 'Rauhalan tila',
    photos: [],
    before: [
      'Vuonna 2021 muutimme <a href="https://rauhantila.net" target="_blank" rel="noopener">pientilalle<span class="visually-hidden"> (avautuu uuteen välilehteen)</span></a>, jossa jatkan tuotteideni rakentamista ja remontointia.',
    ],
  },
];
---

<PortfolioLayout title="Omat projektit – Titiu Rajanto" description="Titiu Rajannon tee-se-itse-projekteja: huonekaluja ja muita rakennelmia.">
  <Fancybox slot="head" />

  <Sheet label="Omat projektit">
    <nav class="back">
      <a href="/#tutustutaan">← Takaisin etusivulle</a>
      <a href="/" class="back__brand" aria-label="Titiu Rajanto – etusivulle"><img src="/img/tiu-logo.svg" alt="Titiu Rajanto" width="40" height="40" /></a>
    </nav>
    <header class="intro">
      <p class="label intro__kicker">Tee se itse</p>
      <h1 class="display intro__title">Omat<br />projektit</h1>
      <div class="intro__lead">
        <p>Rakennan juttuja. Rakennan juttuja tulevaisuudessakin. Ja tulevaisuus on pian täällä.</p>
        <p>
          Joskus aivoja on vaikea saada pois päältä. Aina kun suunnittelen jotain uutta ja olen käyttänyt sitä hetken,
          keksin vähintään viisi uutta ominaisuutta, jotka pitäisi lisätä tai suunnitella uudelleen. Siksi joissakin
          töissäni on versionumero: se kertoo, että parempi versio on jo tulossa tuotantolinjalta.
        </p>
      </div>
    </header>
    <nav class="toc" aria-label="Siirry projektiin">
      {projects.map((p) => <a href={`#${p.id}`}>{p.name}</a>)}
    </nav>
  </Sheet>

  {projects.map((p, i) => (
    <Sheet label={p.name} id={p.id} bottomLabel={String(i + 1).padStart(2, '0')}>
      <div class="proj-head">
        <h2 class="display proj-head__title">{p.name}</h2>
        {p.version && <span class="proj-head__version">Versio {p.version}</span>}
      </div>

      {p.photos.length > 0 && (
        <div class:list={['photos', { 'photos--pair': p.photos.length > 1 }]}>
          {p.photos.map((ph) => (
            <a class="photo" href={img(ph.file)} data-fancybox={`diy-${p.id}`} data-caption={ph.alt}>
              <img src={img(ph.file)} alt={ph.alt} width={ph.width} height={ph.height} loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      )}

      {(p.before || p.list || p.after) && (
        <div class="prose">
          {p.before?.map((t) => <p set:html={t} />)}
          {p.list && <ol class="numbered">{p.list.map((li) => <li>{li}</li>)}</ol>}
          {p.after?.map((t) => <p set:html={t} />)}
        </div>
      )}
    </Sheet>
  ))}

  <ContactSheet />
</PortfolioLayout>

<style>
  .back {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px var(--pad);
    border-bottom: var(--line);
    font-size: 16px;
  }
  .back a { text-decoration: none; padding: 10px 0; }
  .back .back__brand { padding: 0; }
  .back a:hover { color: var(--plum); }
  .back__brand { display: flex; align-items: center; }
  .back__brand img { display: block; width: 40px; height: 40px; }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 120px var(--pad) 48px;
    border-bottom: var(--line);
  }
  .intro__kicker { color: var(--plum); }
  .intro__title { font-size: clamp(44px, 8vw, 112px); line-height: 0.92; color: var(--orange); }
  .intro__lead { display: flex; flex-direction: column; gap: 16px; max-width: 760px; font-size: 19px; line-height: 30px; }

  .toc { display: flex; flex-wrap: wrap; gap: 8px; padding: 24px var(--pad); }
  .toc a {
    font-size: 16px;
    font-weight: 700;
    padding: 6px 14px;
    border: 1px solid var(--plum);
    border-radius: 999px;
    color: var(--plum);
    text-decoration: none;
  }
  .toc a:hover { background: var(--plum); color: var(--paper); }

  .proj-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding: 40px var(--pad);
    background: var(--plum);
    color: var(--paper);
  }
  .proj-head__title { font-size: clamp(32px, 5vw, 64px); line-height: 1; }
  .proj-head__version {
    padding: 4px 12px;
    font-size: 16px;
    font-weight: 700;
    border-radius: 999px;
    background: var(--orange);
    color: var(--ink);
  }

  .photos { display: grid; border-bottom: var(--line); background: var(--page); }
  .photos--pair { grid-template-columns: 1fr 1fr; }
  .photos--pair .photo + .photo { border-left: var(--line); }
  .photo { display: flex; align-items: center; justify-content: center; cursor: zoom-in; }
  .photo:focus-visible { outline: 2px solid var(--orange); outline-offset: -4px; }
  .photo img { display: block; width: 100%; height: auto; max-height: 900px; object-fit: contain; transition: opacity 0.15s ease; }
  .photo:hover img { opacity: 0.92; }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 40px var(--pad) 48px;
    font-size: 17px;
    line-height: 28px;
    overflow-wrap: break-word;
  }
  .prose > * { max-width: 720px; }
  .prose :global(a) { color: var(--plum); }

  .numbered { counter-reset: n; display: flex; flex-direction: column; gap: 12px; }
  .numbered li {
    counter-increment: n;
    position: relative;
    padding: 16px 16px 16px 60px;
    border: var(--line);
  }
  .numbered li::before {
    content: counter(n, decimal-leading-zero);
    position: absolute;
    left: 16px;
    top: 14px;
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--orange);
  }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  @media (max-width: 900px) {
    .intro { padding-top: 56px; }
    .intro__title { font-size: clamp(34px, 11vw, 64px); }
    .proj-head { padding: 32px var(--pad); }
    .proj-head__title { font-size: clamp(26px, 8vw, 40px); }
    .toc a { padding: 9px 14px; }
    .photos--pair { grid-template-columns: 1fr; }
    .photos--pair .photo + .photo { border-left: none; border-top: var(--line); }
  }
</style>
