<script>
  // Image swap toggles (floor plan years, before/after photos).
  document.querySelectorAll<HTMLButtonElement>('[data-swap-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = document.getElementById(btn.dataset.swapTarget!) as HTMLImageElement | null;
      if (!target || !btn.dataset.src) return;
      target.src = btn.dataset.src;
      target.alt = btn.dataset.alt ?? '';
      // Keep the lightbox link in sync with the visible image
      const link = target.closest<HTMLAnchorElement>('a[data-fancybox]');
      if (link) link.href = btn.dataset.src;
      const group = btn.closest('[data-swap-group]');
      group?.querySelectorAll('[data-swap-target]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b === btn)),
      );
    });
  });
</script>

