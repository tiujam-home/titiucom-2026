---
/**
 * Ystävyyden Majatalo case study. Content from titiu.com/ystavyyden-majatalo.
 * This slug is excluded from [slug].astro, which renders the other cases.
 */
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import Sheet from '../../components/portfolio/Sheet.astro';
import ContactSheet from '../../components/portfolio/ContactSheet.astro';
import Fancybox from '../../components/portfolio/Fancybox.astro';
import { cases } from '../../data/cases';

const slug = 'ystavyyden-majatalo';
const index = cases.findIndex((c) => c.slug === slug);
const item = cases[index];
const number = String(index + 1).padStart(2, '0');
const img = (f: string) => `/img/majatalo/${f}`;

const years = ['2013', '2014', '2015', '2016', '2017', '2018'];

const stakeholders = [
  'Majatalon omistajat ja henkilökunta',
  'Majatalossa asuvat asukkaat',
  'Asunto-osakeyhtiön osakkaat',
  'Yhdistyksen jäsenet',
  'Hallitusten jäsenet (yhdistys ja asunto-osakeyhtiö)',
  'Satunnaisesti poikkeavat B&B-matkailijat',
  'Tiloja vuokraavat kurssien vetäjät ja tilaisuuksien järjestäjät',
  'Kursseille ja tilaisuuksiin osallistuvat',
  'Lyhyen aikaa paikalla käyvät vapaaehtoiset',
  '”Majatalon ystävät”: tukijat, huonekummit, pitkäaikaiset lahjoittajat ja tukijat sekä asukkaiden ja henkilökunnan ystävät ja perheet',
  'Ihmiset, jotka eivät olleet koskaan käyneet Majatalossa mutta tilasivat uutiskirjeen ja seurasivat somekanavia (mahdollisia tulevia lahjoittajia, vieraita tai kurssiasiakkaita)',
  'Sen kylän asukkaat, jossa Majatalo sijaitsi',
  'Kunnan viranhaltijat ja viranomaiset',
];

const activities = [
  'Olla tai tulla työntekijäksi',
  'Jäädä pitkäksi aikaa, ryhtyä asukkaaksi',
  'Ostaa asunto-osakeyhtiön osakkeita',
  'Liittyä yhdistyksen jäseneksi',
  'Yöpyä B&B:ssä',
  'Järjestää kurssi tai tilaisuus',
  'Ilmoittautua kurssille tai osallistua tilaisuuteen',
  'Osallistua vapaaehtoistyöhön (lähinnä viikonloppuisin ja tapahtumissa)',
  'Lahjoittaa yhdistykselle',
  'Ryhtyä yhdistyksen kuukausilahjoittajaksi',
  'Tukea vierashuoneen remonttia',
  'Viettää päivä tai pari lomaillen',
  'Kerätä rohkeutta ihan ensimmäiseen Majatalon vierailuun (se saattoi jännittää)',
  'Hyödyntää Majatalon keskeistä sijaintia ja tilavia tiloja paikallisten seurojen, harrastusryhmien ja yhteisön kokoontumisiin',
  'Valvoa paloturvallisuus-, terveydensuojelu-, ympäristö- ja muiden määräysten noudattamista',
];

const screenshots = [
  { file: 'inn-web-home.png', label: 'Etusivu' },
  { file: 'inn-web-news.png', label: 'Uutiset' },
  { file: 'inn-web-page.png', label: 'Sisältösivu' },
  { file: 'inn-web-calendar.png', label: 'Kurssikalenteri' },
  { file: 'inn-web-contact.png', label: 'Yhteystiedot' },
];

const quotes = [
  {
    text: '”Tiu on harvinainen yhdistelmä strategista tekijää ja luovaa visionääriä. Minua kosketti aina se, miten ystävällisesti ja rehellisesti hän kohteli vieraita. Hän kohtasi jokaisen suoraan ja otti aikaa varmistaakseen, että jokainen tunsi olonsa tervetulleeksi ja kotoisaksi. Hänellä on intuitiivinen silmä nähdä, kuka sopisi parhaiten mihinkin vapaaehtoistehtävään. Hän huolehti aina siitä, että nekin, jotka halusivat vain rentoutua ja lomailla, tunsivat olonsa yhtä kotoisaksi kuin asukkaat. On vaikea edes kuvitella, että kukaan olisi lähtenyt Majatalosta pettyneenä hänen huomassaan.”',
    name: 'Tapio Waismaa',
    role: 'Kohtaaminen ry:n entinen hallituksen jäsen',
    photo: '/img/tapio.jpg',
  },
  {
    text: '”Tiulla on ainutlaatuinen kyky luoda järjestystä kaaoksesta. Majatalossa hän näki jotenkin sotkun ja väliaikaisratkaisujen kerrosten läpi todellisen potentiaalin. Ongelmasta riippumatta hän purki sen osiin, kokosi siitä hallittavia paloja ja delegoi työn. Majatalolla ei koskaan ollut ammattimaista työvoimaa, mutta silti Tiun johdolla jokainen pääsi osallistumaan omien kykyjensä mukaan. Lisäksi hän oli aina valmis ojentamaan auttavan käden ja kuuntelemaan ketä tahansa, joka sitä tarvitsi. Oli ilo ja kunnia tehdä töitä hänen rinnallaan. Vuosien aikana näin Majatalon muuttuvan nopeasti uppoavasta jollasta rustiikiksi jokiveneeksi, joka on leveä ja vakaa.”',
    name: 'Jenny Rajanto',
    role: 'Majatalon entinen asukas ja työntekijä',
    photo: '/img/jenny.jpg',
  },
  {
    text: '”Titiussa yhdistyvät harvinaisella tavalla viisaus ja käytännön taidot, ja hän tavoittelee päämääriään sinnikkäästi. Luova ajattelu tulee aina mukaan kuvioihin, kun hän on paikalla, ja silti hänellä on lahja saada ihmiset seuraamaan häntä ja auttamaan tavoitteiden saavuttamisessa. Hänen mukavuusalueensa on työskennellä pienessä, luotettujen ihmisten tiimissä selkeän tavoitteen parissa, mutta tarvittaessa hän kasvaa johtajan rooliin, jota julkisemmat ja hankalammat tilanteet vaativat.”',
    name: 'Tiina Saukko',
    role: 'Huonekummi ja mentori',
    photo: '/img/tiina.jpg',
  },
];

// Stats table: [label, values per year 2013–2017 (with change), total change]
const stats: { label: string; values: string[]; total: string }[] = [
  { label: 'Yhteydenotot (sähköpostikeskustelut)', values: ['708', '925 (+30 %)', '914 (−1 %)', '1 153 (+26 %)', '1 197 (+4 %)'], total: '+69 %' },
  { label: 'Kurssit / tapahtumat', values: ['42', '53', '61', '54', '61'], total: '+45 %' },
  { label: 'Huoneet / vuodepaikat (parisänky = 2 paikkaa)', values: ['20 / 48', '', '', '', '24 / 63'], total: '+20 % / +31 %' },
  { label: 'Verkkosivuston kävijät', values: ['18 900', '23 500 (+24 %)', '23 800 (+1 %)', '24 500 (+3 %)', '31 800* (+30 %)'], total: '+30 %' },
  { label: 'Uutiskirjeen tilaajat', values: ['1 375', '1 630 (+18 %)', '1 795 (+10 %)', '1 711 (−5 %)', '1 897 (+11 %)'], total: '+38 %' },
  { label: 'Facebook-sivun tykkäykset', values: ['1 249', '1 841 (+47 %)', '2 111 (+15 %)', '2 562 (+21 %)', '2 841 (+11 %)'], total: '+127 %' },
];
const statNotes = [
  { year: '2013', notes: ['Viikoittaiset talopalaverit aloitettiin', 'Järjestyssääntöjen 1. versio valmis', 'Uusi kirjanpitojärjestelmä'] },
  { year: '2014', notes: ['Kaikki verovelat maksettu'] },
  { year: '2016', notes: ['Kokoustila Sovinto valmis käyttöön'] },
  { year: '2017', notes: ['*Poikkeuksellisen paljon liikennettä, kun uuden toiminnanjohtajan työpaikkailmoitus julkaistiin. Vuonna 2018 liikenne palasi vuoden 2016 tasolle.'] },
];
---

<PortfolioLayout title={`${item.title} – Titiu Rajanto`} description="Ystävyyden Majatalo: palvelumuotoilua, muutosjohtamista ja operatiivista johtamista 2013–2017.">
  <Fancybox slot="head" />

  <!-- Intro -->
  <Sheet label="Työnäytteet" bottomLabel={number}>
    <nav class="back">
      <a href="/#tyonaytteet">← Takaisin työnäytteisiin</a>
      <a href="/" class="back__brand" aria-label="Titiu Rajanto – etusivulle"><img src="/img/tiu-logo.svg" alt="Titiu Rajanto" width="40" height="40" /></a>
    </nav>
    <header class="intro">
      <p class="label intro__num">Työnäyte {number}</p>
      <h1 class="display intro__title">Ystävyyden<br />Majatalo</h1>
      <div class="intro__lead">
        <p>
          Ystävyyden Majatalo (jatkossa Majatalo) oli yksi urani laajimmista ja haastavimmista projekteista.
          Se alkoi verkkonäkyvyyden uudistuksesta ja laajeni lopulta monivuotiseksi sydämen asiaksi, johon kuului
          <strong>palvelumuotoilua, muutosjohtamista</strong> ja <strong>operatiivista johtamista</strong>.
        </p>
        <p>
          Voisi sanoa, että projekti oli koko liiketoiminnan remontti. Se ulottui arjen askareista (kuten aamiaisen
          laittamisesta tai saunan lämmittämisestä vieraille) budjetin tasapainottamiseen, järjestyssääntöjen
          kirjoittamiseen niin asukkaille kuin vieraille sekä yhteistyöhön kunnan ja viranomaisten kanssa. Puhumattakaan
          oikeiden vierashuoneiden suunnittelusta ja rakentamisesta. Mutta ei mennä asioiden edelle. Mikä tämä paikka oli ja on?
        </p>
      </div>
      <ul class="tags">{item.tags.map((t) => <li>{t}</li>)}</ul>
    </header>
    <div class="facts">
      <div class="facts__col">
        <h2 class="label">Aikajana</h2>
        <p>Verkkosivuston uudistus tehtiin vuonna 2012, ja se kesti noin kolme kuukautta.</p>
        <p>Laajempi liiketoiminnan uudistus tehtiin vuosina 2013–2017, eli siihen meni vajaat viisi vuotta.</p>
      </div>
      <div class="facts__col">
        <h2 class="label">Rooli</h2>
        <p>Aloitin sivuston graafisesta suunnittelusta, käyttöliittymäsuunnittelusta ja hakukoneoptimoinnista.</p>
        <p>
          Myöhemmin toiminnanjohtajana vastasin kymmenistä osa-alueista, kuten asiakaspalvelusta, tarjousten tekemisestä,
          tapahtumien koordinoinnista, vapaaehtoisten perehdyttämisestä, remontti- ja kunnossapitotöiden johtamisesta,
          kirjanpidosta, oppaiden, ohjeiden ja dokumentaation kirjoittamisesta sekä raportoinnista hallitukselle. Lista oli pitkä. :)
        </p>
      </div>
      <div class="facts__col">
        <h2 class="label">Päähaaste</h2>
        <p>
          Miten viestiä organisaation sanomaa, kun organisaatio oli ainutlaatuinen ja epätavallinen konsepti, joka yhdistää
          liiketoimintaa, yhteiskuntavastuuta, yksityistä tukea ja vapaaehtoistyötä – ja palvelee pitkää listaa sidosryhmiä?
        </p>
        <p>Miten koko liiketoimintakonsepti saadaan kestäväksi pitkällä aikavälillä sekä taloudellisesti että käytännössä?</p>
      </div>
    </div>
  </Sheet>

  <!-- Toiminnan esittely -->
  <Sheet label="Toiminnan esittely">
    <img class="banner" src={img('the-inn-buildings.jpg')} alt="Päärakennus, pieni talo ja saunarakennus" width="1987" height="747" />
    <div class="split">
      <div class="prose">
        <h2 class="display h2">Toiminnan esittely</h2>
        <p><strong>Kohtaaminen ry</strong> on pieni, yksityinen ja voittoa tavoittelematon yhdistys, jonka päätavoite on tarjota asuinpaikka sitä tarvitseville.</p>
        <p>
          Toimintansa rahoittamiseksi yhdistys tarjoaa B&amp;B-majoitusta ja vuokraa tilojaan juhliin ja tilaisuuksiin. Majatalossa
          järjestetään myös paljon kursseja, joita vetävät sekä oma henkilökunta että ulkopuoliset ammattilaiset. Toimintaa pyörittävät
          pääosin majatalossa asuvat asukkaat ja siellä vierailevat vapaaehtoiset, sillä virallista henkilökuntaa on kerrallaan vain 2–3.
          Yhdistyksellä on myös yksityisiä tukijoita, joiden lahjoitukset muodostavat 15–20 prosenttia liikevaihdosta. Julkista rahoitusta
          se ei saa. Yhdistys on perustettu vuonna 1988.
        </p>
        <p>
          Yhdistys vuokraa tilansa asunto-osakeyhtiöltä, <strong>Ystävyyden Majatalo Oy:ltä</strong>, joka sijaitsee Salon lähellä,
          suunnilleen Helsingin ja Turun puolivälissä. <strong>1600 m²:n tilat</strong> koostuvat neljästä rakennuksesta: vuonna 1928
          rakennetusta päärakennuksesta, joka oli alun perin meijeri, saunarakennuksesta, pienemmästä vuonna 1970 rakennetusta
          asuinrakennuksesta sekä varastoladosta. Käytännössä yhdistys ylläpitää tiloja, sillä asunto-osakeyhtiöllä ei ole palkattua henkilökuntaa.
        </p>
      </div>
      <aside class="box box--plum">
        <h3 class="label">Heidän omin sanoin</h3>
        <p><em>”Täällä Ystävyyden Majatalossa tehtävämme on aina ollut tehdä hyvää. Yli 30 vuoden ajan olemme toimineet voittoa tavoittelemattomana yhdistyksenä ja tarjonneet turvasataman niin henkiseen kuin fyysiseen toipumiseen.</em></p>
        <p><em>Uskomme, että vaikka joku olisi heikommassa asemassa – konkurssissa, henkisesti lopussa tai uupunut – häneltä ei saa evätä perustarpeita. Majatalo on paikka toipua taloudellisesta tilanteesta riippumatta.”</em></p>
      </aside>
    </div>
  </Sheet>

  <!-- Sidosryhmäanalyysi -->
  <Sheet label="Sidosryhmäanalyysi">
    <div class="block prose">
      <h2 class="display h2">Sidosryhmä&shy;analyysi</h2>
      <p>
        Jo varhain kävi selväksi, että yksi Majatalon pyörittämisen suurimmista haasteista oli valtava määrä sidosryhmiä. Niin
        verkkosivuilla kuin paikan päällä arjessa piti huomioida hyvin erilaisia sidosryhmiä. Verkkosivuston suunnittelu oli kuitenkin
        helppoa verrattuna fyysisen tilan ja koko palvelun suunnitteluun.
      </p>
      <p>
        Liiketoiminnan ja hyväntekeväisyyden yhdistelmä tarkoitti, että sidosryhmien tarpeet ja intressit olivat joskus ristiriidassa.
        Miten suunnitella 1600 m²:n alue ihmiselle, joka haluaisi investoida paikkaan, ja samalla optimoida se toiselle, joka tarvitsee
        sitä kodikseen toipuessaan uupumuksesta?
      </p>
    </div>
    <p class="display centered-title"><span aria-hidden="true">↶</span>Alustavan kartoitukseni jälkeen tunnistin seuraavat<span aria-hidden="true">↷</span></p>
    <div class="cols2">
      <div class="col">
        <h3 class="display h3">Keskeiset sidosryhmät</h3>
        <ul class="bullets">{stakeholders.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div class="col">
        <h3 class="display h3">Sidosryhmien keskeiset toiminnot</h3>
        <ul class="bullets">{activities.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </Sheet>

  <!-- Verkkonäkyvyys -->
  <Sheet label="Verkkonäkyvyys">
    <div class="block">
      <p class="label kicker">Alku</p>
      <h2 class="display h2">Verkko&shy;näkyvyys</h2>
    </div>
    <div class="split split--top">
      <div class="prose">
        <p>
          Suurin haaste oli luoda selkeä ja johdonmukainen viesti, joka välittäisi perustajan vision ja kaikkien paikan hyväksi työtä
          tehneiden intohimon. Samalla piti välittää tärkeät käytännön tiedot kursseille tuleville, satunnaisille kävijöille, rahaa
          lahjoittaville… jaaa kaikille muille sidosryhmille.
        </p>
        <p>
          Heti alussa nousi esiin vielä yksi haaste: omistajat eivät missään nimessä halunneet tehdä <strong>minkäänlaista</strong>
          markkinointia. Puskaradio oli toiminut heille 20 vuotta, ja siinä haluttiin pysyä. Strategia sopi hyvin organisaation arvoihin,
          mutta se lisäsi entisestään hyvin suunnitellun verkkosivuston merkitystä. Kun ihmiset etsisivät tietoa paikasta, heidän piti
          löytää etsimänsä mahdollisimman helposti ja haluta innolla jakaa löytönsä ystävilleen.
        </p>
        <h3 class="display h3">Ratkaisut</h3>
        <p>Koska organisaatio oli voittoa tavoittelematon ja sen budjetti siksi tiukka, valitsin mahdollisimman paljon ilmaisia ja avoimen lähdekoodin tai edullisia ratkaisuja.</p>
        <p>
          Uusi sivusto rakennettiin <strong>WordPressillä</strong> teemalla, jonka tein heille räätälöitynä. Kahdeksi suurimmaksi
          laajennukseksi, uutiskirjeeksi ja kurssikalenteriksi, valitsin lopulta <strong>Tribulant Softwaren
          <a href="https://tribulant.com/plugins/view/1/wordpress-newsletter-plugin" target="_blank" rel="noopener">Newsletter Pluginin</a></strong>
          ja <strong>Stephen Harrisin <a href="https://wordpress.org/plugins/event-organiser/" target="_blank" rel="noopener">Event Organiser Pluginin</a></strong>.
        </p>
        <p>
          Varmistin, että koodi läpäisi W3C-validoinnin ja että sisältö oli hakukoneoptimoitu sivu- ja artikkelitageineen ja muine
          metatietoineen. Välimuistitin myös suurimman osan sisällöstä nopeampien latausaikojen vuoksi.
        </p>
        <p>
          Majatalon väen keskuudessa oli vakiovitsi, että suomalaiset suhtautuvat paikkoihin, joiden nimessä on sana ”ystävyys”, hyvin
          epäluuloisesti. Jos joku mainostaa ystävällisyyttään, siinä täytyy olla jokin juju, eikö niin? Eikö? Päivitin ilmeen tämä yleisö
          mielessäni. Hain tasapainoa sen välillä, että ilme on ”tarpeeksi rustiikki pysyäkseen uskollisena Majatalon kodinomaisuudelle” ja
          ”tarpeeksi moderni hälventääkseen turhaa epäluuloa”. Sivuston responsiivisuus oli erityisen tärkeää, jotta ohi ajavat pariskunnat
          ja perheet huomaisivat paikan.
        </p>
        <figure class="figure figure--plain">
          <a href={img(screenshots[0].file)} data-fancybox="site-collage" data-caption={screenshots[0].label}>
            <img src={img('case-majatalo-collaction.png')} alt="Kuvakollaasi Majatalon uudistetusta verkkosivustosta. Avaa kuvat sivustosta." width="1300" height="682" loading="lazy" />
          </a>
          {screenshots.slice(1).map((s) => (
            <a href={img(s.file)} data-fancybox="site-collage" data-caption={s.label} hidden></a>
          ))}
          <figcaption>
            Kuvat sivustosta:
            {screenshots.map((s, i) => (
              <>
                <a href={img(s.file)} data-fancybox="site" data-caption={s.label}>{s.label}</a>{i < screenshots.length - 1 ? ' · ' : ''}
              </>
            ))}
          </figcaption>
        </figure>
      </div>
      <aside class="side">
        <h3 class="display h3">Vanhan sivuston keskeiset haasteet</h3>
        <ol class="numbered">
          <li><strong>Ulkoasu näytti hieman vanhentuneelta</strong>, <a href={img('the-inn-old.jpg')} data-fancybox data-caption="Majatalon vanha verkkosivusto">jopa lapselliselta</a>, eikä sitä ollut suunniteltu tai optimoitu mobiilikäyttöön.</li>
          <li><strong>Sisällöltä puuttui johdonmukainen viesti, ja sen olisi voinut järjestää paremmin.</strong> Suuri osa sisällöstä oli aatteellista, ja sivustolta tuntui puuttuvan käytännön tietoa mahdollisille kävijöille (siis paikan päälle tuleville, ei vain sivuston kävijöille).</li>
          <li><strong>Selkeät toimintakehotteet puuttuivat.</strong> Sivuston sisältö piti järjestää niin, että jokainen kävijäprofiili löytäisi tärkeimmän tarvitsemansa tiedon mahdollisimman vähillä klikkauksilla.</li>
          <li><strong>Uutiskirjeet lähetettiin ja postituslistat kerättiin ja päivitettiin käsin.</strong> Siksi kun kunnolliset uutiskirjetyökalut otettiin käyttöön, lähes puolet postituslistasta jouduttiin poistamaan vanhentuneena. Aikamoinen määrä palautuvia viestejä.</li>
        </ol>
        <h3 class="display h3">Mikä toimi jo valmiiksi</h3>
        <p>Sivuston sisältö oli enimmäkseen hyvin kirjoitettua, ja erinomaista sisältöä oli paljon. Tarvittiin vain sisällön järjestäminen johdonmukaisempaan rakenteeseen ja ehkä pientä kasvojenkohotusta joihinkin sisällön osiin.</p>
        <p>Kävijöiltä oli myös vuosien varrella kerätty palautetta, josta sai hienoja nostolainauksia.</p>
      </aside>
    </div>
    <div class="block block--line prose prose--wide">
      <h3 class="display h3">Mitattua menestystä</h3>
      <p>Pieni piikki vuoden 2012 lopussa on kohta, jossa uusi sivusto julkaistiin. Seuraavina vuosina näkyi selvää kasvua vuodesta toiseen, ja Majatalo sai paljon positiivista palautetta uudesta ilmeestä.</p>
      <figure class="figure">
        <img src={img('monthly-users.png')} width="1530" height="259" loading="lazy" alt="Viivakaavio kuukausittaisista yksilöidyistä kävijöistä 2009–2019. Kävijöitä on vuonna 2010 noin 1 000 kuukaudessa ja uudistuksen jälkeen vuosina 2015–2018 noin 2 000–3 000. Helmikuussa 2017 käyrässä on noin 10 000 kävijän piikki." />
        <figcaption>Kaavio näyttää kuukausittaiset yksilöidyt kävijät vuosilta 2009–2019.</figcaption>
      </figure>
      <figure class="figure">
        <img src={img('page-views.png')} width="1527" height="256" loading="lazy" alt="Viivakaavio kuukausittaisista sivujen katselukerroista 2009–2019. Katselukertoja on koko jakson ajan noin 7 000–14 000 kuukaudessa. Helmikuussa 2017 käyrässä on noin 28 000 katselukerran piikki." />
        <figcaption>Kuten tämä sivujen katselukertojen kaavio näyttää, uskollisia kävijöitä oli paljon jo ennen sivuston uudistusta. Katselukerrat eivät muuttuneet yhtä rajusti kuin yksilöidyt kävijät, joten uskolliset tukijat ilmeisesti pysyivät uskollisina tukijoina. :)</figcaption>
      </figure>
      <p>
        <strong>Uutiskirjeen tilaajien osalta</strong> palautuvat viestit vähenivät normaalin tilaajapoistuman tasolle, kun listalta
        siivottiin vanhat osoitteet. Uskolliset tilaajat pysyivät, ja uusia tilaajia alkoi tihkua hiljalleen. Omistajat olivat tyytyväisiä
        siihen, että tällä kertaa listalla oli vain ihmisiä, jotka todella halusivat kuulla kuulumisia. Tilastojen mukaan peräti 60 %
        tilaajista avasi viestit sen sijaan, että olisi poistanut ne tai merkinnyt ne roskapostiksi. Nykyään harvinainen luku.
      </p>
    </div>
  </Sheet>

  <!-- Asiakaskokemus -->
  <Sheet label="Asiakaskokemus">
    <img class="banner" src={img('the-inn-feeling.jpg')} alt="Tunnelmakuva Majatalosta" width="2284" height="690" loading="lazy" />
    <div class="block">
      <p class="label kicker">Varsinainen työ</p>
      <h2 class="display h2">Asiakas&shy;kokemuksen uudelleen&shy;suunnittelu</h2>
    </div>
    <div class="split split--top">
      <div class="prose">
        <p>Kun osallistuin projektiin enemmän ja opin tuntemaan Majatalon tilanteen paremmin, tunsin kutsumusta tehdä muutakin kuin päivittää verkkosivut. Kävi ilmi, että apua tarvittiin monella eri alueella. Verkkosivusto oli vain jäävuoren huippu.</p>
        <p>Ensisilmäyksellä Majatalon tilanne saattoi vaikuttaa toivottomalta, ja tietyllä tavalla se todella olikin. Perustajia oli kohdannut henkilökohtainen tragedia, ja viime vuosina asiat olivat yksinkertaisesti alkaneet lipsua. Tiedät kyllä. Entropia. Se iskee lopulta jokaiseen.</p>
        <p>Ennen kuin lasken eteesi pitkän listan <em>Majatalon haasteita</em>, haluan kertoa, miksi paikan saaminen takaisin jaloilleen tuntui minusta niin tärkeältä. Ympäri maata oli tuhansia ihmisiä, joiden elämää Majatalo oli koskettanut, joissain tapauksissa jopa elämää muuttavalla tavalla. Tieto siitä, että Majatalo jatkaisi olemassaoloaan, oli heille tärkeä lohdun ja turvan lähde. Eräänlainen vakuutus masennusta tai epätoivoa vastaan.</p>
        <p>Oli liikuttavaa todistaa tätä hyvää voimaa. Aloin itsekin uskoa asiaan, ja yhteisön tarmo ja sitoutuminen inspiroivat minua syvästi.</p>
        <p>Noh, lukuisten haastattelujen ja viikkojen omien havaintojen jälkeen minulle oli alkanut muodostua kuva Majatalon asiakaskokemuksen keskeisistä haasteista.</p>
        <p><strong>Kaksi asiaa vaikutti asiakaskokemukseen merkittävästi:</strong> tilat (majoitus, oleskelu, juhlat, kurssit) sekä kohtaamiset Majatalon henkilökunnan ja asukkaiden kanssa. Koska suunniteltavaa ja rakennettavaa asiakastilaa oli paljon, tilojen muuttaminen vaati myös työnjaon muuttamista. Uudelleenjärjestely vaikutti moniin asiakaskohtaamisiin, kuten vastaanottoon, huoneiden siivoukseen, ruoan tarjoiluun ja ylipäätään siihen, että kaikki tärkeä tieto oli niin asukkaiden kuin vieraiden saatavilla.</p>
      </div>
      <aside class="box box--plum">
        <h3 class="label">Lukuisat sidosryhmät ja asiakaskokemuksen suunnittelu</h3>
        <p>Mitä tahansa ongelmaa ratkaistessa piti aina ottaa askel taaksepäin ja miettiä, miten ratkaisu vaikuttaa kaikkiin eri sidosryhmiin. Yhdelle ryhmälle paras ratkaisu saattoi olla toiselle haitallinen.</p>
        <p>Kuten olin oppinut verkkosivuprojektin aikana, Majatalon ”käyttäjät” olivat hyvin moninaisia. Siksi oli haastavaa luoda jokaiselle profiilille positiivinen asiakaskokemus vesittämättä ydinkonseptia (jota ilman paikkaa ei voisi olla olemassa) tai tekemättä siitä liian vaikeaa ylläpitää.</p>
      </aside>
    </div>

    <p class="display centered-title"><span aria-hidden="true">↶</span>Asiakaskokemuksen keskeiset suunnitteluhaasteet<span aria-hidden="true">↷</span></p>
    <div class="cols2">
      <div class="col">
        <h3 class="display h3">Tilat</h3>
        <details class="acc"><summary>Tiloja ei ollut jaettu käytännöllisesti ja selkeästi</summary>
          <p>Yleisiä tiloja, majoitustiloja ja asuintiloja oli vaikea erottaa toisistaan. Siksi kävijöiden ja vapaaehtoisten oli vaikea tietää esimerkiksi, minne he saivat mennä tai mistä tietyt välineet löytyivät.</p>
          <p>Yleiset tilat olisi pitänyt suunnitella vierailuun ja oleskeluun, ja majoitustilat olisi pitänyt erottaa selkeästi asukkaiden huoneista.</p>
        </details>
        <details class="acc"><summary>Rakennuksista puuttuivat selkeät varastotilat… ja tavaraa oli yksinkertaisesti liikaa</summary>
          <p>Vuosien luottaminen lahjoitettuihin huonekaluihin ja välineisiin oli johtanut tilanteeseen, jossa jokainen huone, käytävä, nurkka ja sopukka oli täynnä tavaraa. Kukaan ei uskaltanut heittää pois vanhoja välineitä, vaikka ne tuskin enää toimivat.</p>
          <p>Tilojen siivoaminen ja ylläpito oli tarpeettoman vaikeaa, koska vanhoja työkaluja, huonekaluja ja tavaroita oli siellä täällä miten sattui. Kukaan ei ajatellut tiloja käytettävyyden näkökulmasta.</p>
        </details>
        <details class="acc"><summary>Tärkeimmät välineet olivat vanhoja, usein keskenään yhteensopimattomia tai vain vaikeasti löydettävissä</summary>
          <p>Tämä vaikutti myös henkilökunnan ja asukkaiden haluun siivota, korjata ja järjestää asioita. Kun muutin Majataloon, löysin kahdeksan eri merkin pölynimuria, joista jokaiseen sopi eri pölypussi ja joista yksi toimi kunnolla.</p>
          <p>Tämä johti myös resurssien tuhlaukseen, sillä uusia tavaroita ostettiin vain siksi, ettei kukaan löytänyt aiemmin ostettuja.</p>
        </details>
        <details class="acc"><summary>Monissa tiloissa näkyi jo vakavia kulumisen merkkejä</summary>
          <p>Koska Majatalo oli ollut ensimmäiset 20 toimintavuottaan jatkuvan taloudellisen paineen alla, monet majoitushuoneet olivat kuluneita ja monet huoltotilat huonossa kunnossa.</p>
          <p>Asiakkailta oli alkanut tulla negatiivista palautetta. Vaikka he rakastivat Majatalon tehtävää ja henkeä, majoitushuoneiden ja oleskelutilojen kunto oli saanut heidät vierailemaan harvemmin.</p>
        </details>
      </div>
      <div class="col">
        <h3 class="display h3">Työnjako</h3>
        <details class="acc"><summary>Riittämättömät merkinnät ja työohjeet</summary>
          <p>Dokumentaatiota ei ollut tarpeeksi, jotta asukkaiden ja vapaaehtoisten suuri vaihtuvuus olisi saatu hallintaan. Monet olemassa olevista ohjeista olivat vanhentuneita, ristiriitaisia tai epäjohdonmukaisia. Ohjeita oli yksinkertaisesti liikaa, mikä aiheutti ”ponnahdusikkunasokeutta”: ihmiset lakkasivat kiinnittämästä huomiota ohjeisiin ja merkintöihin. Vapaaehtoiset piti perehdyttää perustehtäviinkin, jotka hyvin suunniteltu, hyvin sijoitettu ja tarpeeksi lyhyt ohje olisi hoitanut.</p>
        </details>
        <details class="acc"><summary>Tärkeitä päätöksiä ja linjauksia ei ollut dokumentoitu riittävästi</summary>
          <p>Uusilla työntekijöillä tai yhdistyksen jäsenillä ei ollut mitään keinoa ymmärtää, millaisia päätöksiä operatiivinen johto ja hallitus olivat aiemmin tehneet ja miksi. Tämä johti samojen virheiden toistamiseen, usein turhaan, vuosien varrella. ”Hiljainen tieto” oli omistajien ja entisten asukkaiden päissä, eikä missään muualla.</p>
          <p>Tämä oli johtanut tiedostamattomaan ”selviytymisen” strategiaan ja energiaan ”kukoistamisen” sijaan. Monet ratkaisut olivat lyhytnäköisiä, ja aluksi tuntui mahdottomalta saada ihmiset näkemään valoa tunnelin päässä.</p>
        </details>
        <details class="acc"><summary>Heikko taloushallinto vaikeutti talouden seurantaa ja suunnittelua</summary>
          <p>Kirjanpito tehtiin paperilla, mikä teki kaikenlaisesta vertailevasta analyysistä äärimmäisen vaikeaa. Lisäksi, kuten maaseudulla on tyypillistä, suurin osa kaupasta oli tehty käteisellä ja ilman kuitteja. Tulolähteet olivat siis parhaita arvioita, jotka usein kirjattiin viikon tai kuukauden lopussa. Arvattuihin lukuihin perustuvassa liiketoiminnan analysoinnissa ei ollut paljon järkeä.</p>
          <p>Saatat ajatella, että näin pienellä organisaatiolla täytyy olla yksinkertainen liiketoimintamalli. Majoituksen, ruoan, vuokrien, kurssimaksujen ja lahjoitusten tulolähteiden lisäksi oli kuitenkin monta asiakasryhmää omine toimintoineen: kursseja, juhlia, vuosittaisia tapahtumia, B&amp;B-majoitusta, asumista ja niin edelleen.</p>
          <p>Jos halusimme kasvattaa tuloja, meidän piti ymmärtää, mistä raha tällä hetkellä tuli ja millaiseen toimintaan kannatti panostaa.</p>
          <p>No, onnea onnettomuudessa: aloitusvuoteni toiminnanjohtajana oli ensimmäinen vuosi, jolloin yhdistys joutui perimään ja tilittämään arvonlisäveroa palveluistaan. Yhtäkkiä jokainen maksutapahtuma piti dokumentoida. Ja niin astuivat kuvaan pilvipohjainen kirjanpito ja kunnolliset liiketoiminta-analyysit.</p>
        </details>
        <details class="acc"><summary>Työntekijöitä ei ollut tarpeeksi</summary>
          <p>Majatalossa oli keskimäärin vain kaksi palkattua työntekijää (toiminnanjohtaja ja emäntä/yhteisövastaava), ja suurimman osan arjen askareista, kuten majoituksen, maksujen käsittelyn, pihatöiden ja keittiötöiden, hoitivat vapaaehtoiset. Siksi suurimmasta osasta paikan päällä tehtävästä työstä ei voinut odottaa ammattitaitoa tai ammattimaista asennetta. Tämä puolestaan tarkoitti, että työ piti suunnitella niin, että sen pystyi oppimaan ja tekemään vähemmälläkin osaamisella.</p>
        </details>
        <details class="acc"><summary>Järjestyssääntöjä ei ollut kirjattu</summary>
          <p>Vaikka tietty ”jokainen saa olla oma itsensä aina” -henki oli Majatalon tunnelman kulmakivi, kirjattujen sääntöjen täydellinen puuttuminen aiheutti epämukavuutta, kiusallisuutta ja hämmennystä niin vieraiden kuin asukkaiden keskuudessa.</p>
          <p>Pahinta oli, että ristiriitojen ratkaiseminen oli vaikeaa, kun mitään kirjattua, yhdessä allekirjoitettua ja hyväksyttyä ei ollut, mihin nojata. Ihmiset olivat aiheellisesti huolissaan siitä, että oikeutta jaettiin perustajien oikkujen mukaan. Tämä vaikutti selvästi työmoraaliin päivittäin.</p>
        </details>
        <details class="acc"><summary>Päivittäistä työtä ei ollut järjestetty tehokkaasti</summary>
          <p>Ilman järjestelmällisyyttä ja läpinäkyvyyttä työkuorma jakautui epätasaisesti, ja yleensä sitä kantoivat kaksi tai kolme tunnollisinta vapaaehtoista. Tämä aiheutti turhaa uupumusta ja heikensi yhtä yhdistyksen perustehtävistä: tarjota kriisissä oleville ihmisille paikka levätä ja toipua.</p>
        </details>
        <details class="acc"><summary>Majatalon sisäinen aikataulu ei ollut kenenkään nähtävillä tai jaettuna</summary>
          <p>Sitä pidettiin paperisessa kalenterissa, joka kulki yhden ihmisen mukana. Talon sisäiselle viestinnälle ja asukkaiden väliselle viestinnälle ei ollut muuta keinoa kuin tavata kasvokkain. Vaikka vapaaehtoiset olisivat halunneet ja pystyneet koordinoimaan työtä keskenään, heillä ei yksinkertaisesti ollut siihen välineitä.</p>
        </details>
      </div>
    </div>

    <p class="display centered-title"><span aria-hidden="true">↶</span>Vahvuudet, joita hyödynnettiin molemmilla osa-alueilla<span aria-hidden="true">↷</span></p>
    <div class="strengths">
      <div class="strength">
        <img src={img('huonetaulu.jpg')} alt="Vastaanoton huonetaulu" width="1000" height="1424" loading="lazy" />
        <div class="prose">
          <p><strong>Epätavallinen paikka mahdollistaa epätavalliset (luovat ja edulliset) ratkaisut.</strong> Paikan perustaja ei juuri välittänyt tavanomaisista toimintatavoista. Se antoi minulle tilaisuuden yhdistellä UX-suunnittelu- ja ongelmanratkaisutaitojani epätavallisilla tavoilla. Nautin todella ratkaisujen etsimisestä, ja osa niistä toimisi vain Ystävyyden Majatalossa.</p>
          <p>Vastaanotossa esimerkiksi teimme majoitushuoneiden pohjapiirroksen, huoneiden nimet ja senhetkisen majoitustilanteen vieraille näkyviksi. Kun vieras alkoi varata huonetta, hän pystyi valitsemaan huoneensa sijainnin, huoneen teeman tai minkä tahansa muun tekijän perusteella. Koska kummihuoneilla oli nimet, huoneet saivat persoonallisuutta. Tämä oli vain yksi Majatalon erikoisuuksista, joita hyödynsimme asiakaskokemuksessa.</p>
        </div>
      </div>
      <div class="strength">
        <img src={img('piled-wood.jpg')} alt="Pinottuja polttopuita" width="757" height="756" loading="lazy" />
        <div class="prose">
          <p><strong>Vahva yhteisöllisyys tarkoitti vankkaa tukea yhteisöltä sekä työn että rahoituksen muodossa.</strong> Pienistä arjen tehtävistä, kuten saunapuiden pilkkomisesta, suurempiin projekteihin, kuten tonnin painoisen betonilohkareen siirtämiseen, apua sai aina asukkailta tai laajemmalta yhteisöltä. Naapurit toivat traktoreitaan, kaivinkoneitaan ja kuorma-autojaan avuksi rakentamiseen ja pihatöihin. Joka vuosi eräs lahjoitti metsästään polttopuut talven yli, ja toinen auras pihatien lumimyräkän jälkeen. Oli tärkeää antaa takaisin yhteisölle ja pitää huolta näistä suhteista.</p>
        </div>
      </div>
      <div class="strength">
        <img src={img('founder.jpg')} alt="Majatalon perustaja" width="1000" height="842" loading="lazy" />
        <div class="prose">
          <p><strong>Paikan aate ja visio olivat vahvoja perustajan ja kaikkien Majatalossa ja sen hyväksi työskennelleiden mielissä.</strong> Se teki kaikista sitkeämpiä vastoinkäymisissä ja kantoi yhdistyksen niiden aikojen yli, jolloin käytännön järjestelyt oli pahasti laiminlyöty. Tämä aatteeseen perustuva yrittäjähenki tarttui satunnaisiinkin kävijöihin. Juuri tämä henki sai ihmiset lahjoittamaan aikaansa ja rahaansa paikan pitämiseksi pystyssä jopa 1990-luvun laman yli.</p>
        </div>
      </div>
    </div>
  </Sheet>

  <!-- Ratkaisut: tilat -->
  <Sheet label="Ratkaisut: tilat">
    <div class="block">
