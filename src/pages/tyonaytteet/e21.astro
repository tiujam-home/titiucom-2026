---

<PortfolioLayout
  title={`${item.title} – Titiu Rajanto`}
  description="Työnäytteitä e21-vuosiltani: verkkokauppoja, portaaleja ja myynnin työkaluja Rudukselle, Mercamerille, JOBmealille, Knaufille ja Rakennustiedolle."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <Fancybox />
  </Fragment>

  <!-- Intro -->
  <Sheet label="Työnäytteet" bottomLabel={number}>
    <nav class="back">
      <a href="/#tyonaytteet">← Takaisin työnäytteisiin</a>
      <a href="/" class="back__brand" aria-label="Titiu Rajanto – etusivulle"><img src="/img/tiu-logo.svg" alt="Titiu Rajanto" width="40" height="40" /></a>
    </nav>
    <header class="intro">
      <p class="label intro__num">Työnäyte {number} · Yksityinen portfolio</p>
      <h1 class="display intro__title"><span class="keep-case">e21</span>:n<br />työnäytteet</h1>
      <div class="intro__lead">
        <p>
          Suunnittelen sovelluksia ja palveluja, jotka helpottavat ihmisten työtä ja arkea: kuljettajan punnitussovelluksen,
          myyjän tarjoustyökalun, rakennusalan sopimuspalvelun. 12 vuotta e21 Solutionsilla, mitattuja tuloksia mm.
          Rudukselle, JOBmealille ja Rakennustiedolle. Etsin nyt tiimiä, jossa suunnittelulla autetaan ihmisiä.
        </p>
      </div>
      <ul class="tags">{item.tags.map((t) => <li>{t}</li>)}</ul>
    </header>
  </Sheet>

  <!-- Sticky project navigation: a direct child of .page so it stays pinned for the whole page -->
  <nav class="toc" aria-label="Siirry projektiin">
    <a href="/" class="toc__brand" aria-label="Titiu Rajanto – etusivulle"><img src="/img/tiu-logo.svg" alt="" width="32" height="32" /></a>
    <div class="toc__links">
      {projects.map((p) => <a href={`#${p.id}`}>{p.toc}</a>)}
    </div>
  </nav>

  {projects.map((p) => (
    <Sheet label={p.toc} id={p.id}>
      <div class="proj-head">
        <div>
          <p class="label proj-head__kicker">{p.kicker}</p>
          <h2 class="display proj-head__title">
            <Fragment set:html={keepCase(p.title)} />
            {p.tag && <span class="proj-head__tag">{p.tag}</span>}
          </h2>
        </div>
        {p.url && (
          <a href={p.url} class="visit" target="_blank" rel="noopener">
            Vieraile<span class="visually-hidden"> sivustolla {p.url.replace('https://', '')} (avautuu uuteen välilehteen)</span> ↗
          </a>
        )}
      </div>

      {p.banner && (
        <div class="banner" style={`--banner-bg: ${p.banner.bg}`}>
          <img src={img(p.banner.file)} alt={p.banner.alt} loading="lazy" decoding="async" />
        </div>
      )}
      {p.inlineBanner && (
        <img class="banner-inline" src={img(p.inlineBanner.file)} alt={p.inlineBanner.alt} loading="lazy" decoding="async" />
      )}

      {p.sections.length > 0 && (
        <div class:list={['split', { 'split--media-first': p.mediaFirst }]}>
          <div class="prose">
            {p.sections.map((s) => (
              <>
                <h3 class="step">{s.heading}</h3>
                {s.text && <p>{s.text}</p>}
                {s.list && <ul class="bullets">{s.list.map((li) => <li>{li}</li>)}</ul>}
              </>
            ))}
          </div>
          {p.media && (
            <div class:list={['media', { 'media--logo': p.media.logo }]}>
              {p.media.kind === 'video' ? (
                <video src={img(p.media.file)} autoplay muted loop playsinline controls aria-label={p.media.alt}></video>
              ) : (
                <img src={img(p.media.file)} alt={p.media.alt} loading="lazy" decoding="async" />
              )}
            </div>
          )}
        </div>
      )}

      {p.video && (
        <div class="block">
          <video class="wide-video" src={img(p.video.file)} autoplay muted loop playsinline controls aria-label={p.video.alt}></video>
        </div>
      )}

      {p.stats && (
        <div class="results">
          <p class="label">{p.statsLabel}</p>
          <div class="stats">
            {p.stats.map((s) => (
              <div class="stat"><b class="display">{s.value}</b><span>{s.text}</span></div>
            ))}
          </div>
        </div>
      )}

      {p.galleries && (
        <div class="block block--line">
          <p class="label gallery-label">Projektin kuvia</p>
          {p.galleries.map((g) => <CaseGallery {...g} base="/img/e21/" />)}
        </div>
      )}

      {p.subs?.map((sub) => (
        <div class="block block--line">
          <div class="prose sub">
            <h3 class="display sub__title">{sub.title}</h3>
            {sub.text.map((t) => <p>{t}</p>)}
          </div>
          {sub.galleries.map((g) => <CaseGallery {...g} base="/img/e21/" />)}
        </div>
      ))}

      {p.quote && (
        <figure class="quote">
          <span class="quote__mark" aria-hidden="true">”</span>
          <blockquote>{p.quote.text.map((t) => <p>{t}</p>)}</blockquote>
          <figcaption class="quote__person">
            <img src={img(p.quote.photo)} alt="" width="56" height="56" loading="lazy" />
            <span>
              <strong>{p.quote.name}</strong><br />
              <span class="quote__role">{p.quote.role}</span><br />
              <a href={linkedin} target="_blank" rel="noopener">Lue lisää suosituksia LinkedInistä<span class="visually-hidden"> (avautuu uuteen välilehteen)</span></a>
            </span>
          </figcaption>
        </figure>
      )}
    </Sheet>
  ))}

  <ContactSheet />
</PortfolioLayout>

<script>
  // Sticky nav: offset anchor jumps by the bar's height and highlight the project in view
  const toc = document.querySelector<HTMLElement>('.toc');
  if (toc) {
    const setNavHeight = () => document.documentElement.style.setProperty('--nav-h', `${toc.offsetHeight}px`);
    setNavHeight();
    window.addEventListener('resize', setNavHeight);

    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('.toc__links a').forEach((a) => links.set(a.hash.slice(1), a));
    const setActive = (id: string | null) => {
      links.forEach((a, key) => {
        if (key === id) {
          a.setAttribute('aria-current', 'true');
          a.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        } else {
          a.removeAttribute('aria-current');
        }
      });
    };
    const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    const update = () => {
      const line = toc.offsetHeight + 40;
      let current: string | null = null;
      for (const s of sections) {
        if (s.getBoundingClientRect().top <= line) current = s.id;
      }
      const last = sections[sections.length - 1];
      if (current && last && last.getBoundingClientRect().bottom < line) current = null;
      setActive(current);
    };
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      }
    }, { passive: true });
    update();
  }

  // Fade images in as they scroll into view
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const items = document.querySelectorAll<HTMLElement>('.shot, .phone, .media, .results');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    items.forEach((el) => {
      const i = Array.prototype.indexOf.call(el.parentElement?.children ?? [], el);
      el.style.transitionDelay = `${(i % 4) * 80}ms`;
      el.classList.add('reveal');
      observer.observe(el);
    });
  }
</script>

<style>
  .back {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px var(--pad);
    border-bottom: var(--line);
    font-size: 16px;
  }
  .back a { text-decoration: none; padding: 10px 0; }
  .back .back__brand { padding: 0; }
  .back a:hover { color: var(--plum); }
  .back__brand { display: flex; align-items: center; }
  .back__brand img { display: block; width: 40px; height: 40px; }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 120px var(--pad) 48px;
  }
  .intro__num { color: var(--plum); }
  .intro__title { font-size: clamp(44px, 8vw, 112px); line-height: 0.92; color: var(--orange); }
  .intro__lead { max-width: 760px; font-size: 19px; line-height: 30px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-size: 16px; line-height: 1.2; padding: 7px 14px; border: var(--line); border-radius: 999px; }

  /* Sticky project nav: its own card between the intro and the first project, pinned to the top when scrolling */
  .toc {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px var(--pad);
    background: var(--paper);
    border: var(--line);
  }
  .toc__brand { flex-shrink: 0; display: flex; }
  .toc__brand img { display: block; width: 32px; height: 32px; }
  .toc__links { display: flex; flex-wrap: wrap; gap: 8px; }
  .toc__links a {
    font-size: 16px;
    font-weight: 700;
    padding: 6px 14px;
    border: 1px solid var(--plum);
    border-radius: 999px;
    color: var(--plum);
    text-decoration: none;
    white-space: nowrap;
  }
  .toc__links a:hover,
  .toc__links a[aria-current='true'] { background: var(--plum); color: var(--paper); }

  /* Project header band */
  .proj-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 40px var(--pad);
    background: var(--plum);
    color: var(--paper);
  }
  .proj-head__kicker { color: var(--plum-soft); margin-bottom: 8px; }
  .proj-head__title { font-size: clamp(32px, 5vw, 64px); line-height: 1; }
  .proj-head__tag {
    display: inline-block;
    vertical-align: middle;
    margin-left: 12px;
    padding: 4px 12px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
    border-radius: 999px;
    background: var(--orange);
    color: var(--ink);
  }
  .visit {
    flex-shrink: 0;
    padding: 10px 20px;
    border: 1px solid var(--paper);
    border-radius: 999px;
    font-weight: 700;
    color: var(--paper);
    text-decoration: none;
  }
  .visit:hover { background: var(--paper); color: var(--plum); }

  .banner { background: var(--banner-bg, var(--page)); border-bottom: var(--line); }
  .banner img { display: block; width: 100%; max-width: 1400px; height: auto; margin: 0 auto; }
  .banner-inline { display: block; width: 100%; height: auto; border-bottom: var(--line); }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 48px;
    padding: 40px var(--pad);
    align-items: start;
  }
  .split--media-first .media { order: -1; }
  .split--media-first { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); }
  .prose { display: flex; flex-direction: column; gap: 14px; line-height: 28px; font-size: 17px; overflow-wrap: break-word; }
  .prose > * { max-width: 720px; }
  .step { font-family: var(--font-display); font-weight: 400; font-size: 18px; text-transform: uppercase; color: var(--plum); margin-top: 10px; }
  .step:first-child { margin-top: 0; }
  .bullets { display: flex; flex-direction: column; gap: 8px; }
  .bullets > li { position: relative; padding-left: 22px; }
  .bullets > li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 10px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
  }
  .media { position: sticky; top: 24px; }
  .media img, .media video { display: block; width: 100%; height: auto; border: var(--line); }
  .media--logo img { border: none; max-width: 360px; margin: 0 auto; }

  .block { padding: 40px var(--pad); }
  .block--line { border-top: var(--line); }
  .gallery-label { color: var(--plum); }
  .wide-video { display: block; width: 100%; height: auto; border: var(--line); }

  .sub { margin-bottom: 8px; }
  .sub__title { font-size: clamp(26px, 3vw, 36px); line-height: 1.1; letter-spacing: -0.01em; }

  .results { padding: 32px var(--pad); border-top: var(--line); background: var(--plum-soft); }
  .results .label { color: var(--plum); margin-bottom: 16px; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px; }
  .stat { display: flex; flex-direction: column; gap: 6px; line-height: 24px; }
  .stat b { font-size: clamp(32px, 4vw, 48px); line-height: 1; color: var(--plum); font-weight: 400; }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 40px var(--pad);
    border-top: var(--line);
    background: var(--page);
  }
  .quote__mark { font-family: var(--font-display); font-size: 80px; line-height: 0.6; height: 32px; color: var(--plum); }
  .quote blockquote { margin: 0; display: flex; flex-direction: column; gap: 14px; max-width: 860px; font-size: 18px; line-height: 29px; }
  .quote__person { display: flex; align-items: center; gap: 14px; line-height: 24px; }
  .quote__person img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; filter: grayscale(1); flex-shrink: 0; }
  .quote__role { color: var(--muted); }
  .quote__person a { color: var(--plum); font-size: 15px; }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  /* Scroll-in fade (classes added by the script; gallery items live in CaseGallery) */
  :global(.reveal) { opacity: 0; transform: translateY(16px); transition: opacity 0.5s ease, transform 0.5s ease; }
  :global(.reveal.is-visible) { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .intro { padding-top: 56px; }
    .proj-head { flex-direction: column; align-items: flex-start; padding: 32px var(--pad); }
    .split, .split--media-first { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .split--media-first .media { order: 0; }
    .media { position: static; }
    .intro__title { font-size: clamp(32px, 9.5vw, 56px); }
    .proj-head__title { font-size: clamp(26px, 7.5vw, 40px); }
    .sub__title { font-size: 24px; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; }
    .stat b { font-size: 30px; }
    /* One scrollable row on phones so the bar doesn't eat half the screen */
    .toc { gap: 12px; padding: 8px var(--pad); }
    .toc__links {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-right: calc(var(--pad) * -1);
      padding-right: var(--pad);
    }
    .toc__links::-webkit-scrollbar { display: none; }
    .toc__links a { padding: 9px 14px; }
    .quote__person a { display: inline-block; padding: 8px 0; }
    .visit { padding: 12px 20px; }
  }
</style>
