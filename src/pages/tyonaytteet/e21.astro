    ],
    galleries: [
      { kind: 'shots', group: 'knauf', heroFirst: true, items: [
        { file: 'knauf-tarjoukset.webp', caption: 'Myyjän työpöytä: projektitarjoukset tilamerkintöineen' },
        { file: 'knauf-kohdetarjous.webp', caption: 'Projektitarjous: tuotteet, sopimushinnat, alennukset ja tekstipohjat' },
        { file: 'knauf-vuosisopimus.webp', caption: 'Vuosisopimus: tuoteryhmäalennukset ja suoraan hinnoitellut tuotteet' },
