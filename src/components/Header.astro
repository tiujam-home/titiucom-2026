---
const links = [
  { label: 'Työnäytteet', href: '/tyonaytteet' },
  { label: 'Tutustutaan', href: '/tutustutaan' },
  { label: 'Näin työskentelen', href: '/#nain-tyoskentelen' },
];
---

<header class="header section-inner">
  <a href="/" class="brand">
    <span class="brand__badge">Tiu</span>
    <span class="brand__name">Titiu Rajanto</span>
  </a>
  <nav class="nav" aria-label="Päävalikko">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href="/ota-yhteytta" class="nav__cta">Ota yhteyttä</a>
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 28px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }
  .brand__badge {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-plum);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 20px;
  }
  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .nav a {
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .nav a:hover { color: var(--color-plum); }
  .nav .nav__cta {
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--color-plum);
    color: var(--color-white);
    font-weight: 600;
  }
  .nav .nav__cta:hover { color: var(--color-white); opacity: 0.9; }

  @media (max-width: 860px) {
    .nav a:not(.nav__cta) { display: none; }
  }
</style>
