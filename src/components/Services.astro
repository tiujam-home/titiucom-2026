---
const services = [
  {
    title: 'Käyttöliittymäsuunnittelu',
    text: 'Verkkosivuille ja -sovelluksille. Pohjana käyttöliittymämallit ja käyttäjien todellinen, mitattava käyttäytyminen.',
  },
  {
    title: 'Front-end-kehitys',
    text: 'Hyvin kirjoitettua HTML- ja CSS-koodia, joka on siistiä ja uudelleenkäytettävää.',
  },
  {
    title: 'Käyttäjäkokemus ja palvelumuotoilu',
    text: 'Muotoiluajattelua, empaattista kuuntelua ja strategiatyötä.',
  },
  {
    title: 'Rauhallinen projektinjohto',
    text: 'Kokemusta useilta toimialoilta työntekijän, esihenkilön ja yrittäjän näkökulmasta.',
  },
];
---

<section class="services" id="nain-tyoskentelen">
  <div class="services__inner section-inner">
    <div class="services__intro">
      <p class="eyebrow">Näin työskentelen</p>
      <h2 class="section-title">Mitä tuon mukanani</h2>
    </div>
    <ol class="services__list">
      {services.map((item, i) => (
        <li>
          <span class="services__num">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services { background: var(--color-plum-tint); }
  .services__inner {
    display: flex;
    gap: 96px;
    padding-block: 96px;
  }
  .services__intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 360px;
    flex-shrink: 0;
  }
  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex-grow: 1;
    border-bottom: 1px solid var(--color-plum-line);
  }
  .services__list li {
    display: flex;
    gap: 32px;
    padding-block: 28px;
    border-top: 1px solid var(--color-plum-line);
  }
  .services__num {
    width: 40px;
    flex-shrink: 0;
    padding-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-plum);
  }
  .services__list h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    line-height: 32px;
    margin-bottom: 6px;
  }
  .services__list p {
    font-size: 17px;
    line-height: 28px;
    color: var(--color-ink-soft);
  }

  @media (max-width: 1024px) {
    .services__inner { flex-direction: column; gap: 40px; padding-block: 72px; }
    .services__intro { width: auto; }
  }
  @media (max-width: 640px) {
    .services__list li { gap: 16px; }
    .services__num { width: 28px; }
    .services__list h3 { font-size: 22px; line-height: 28px; }
  }
</style>
