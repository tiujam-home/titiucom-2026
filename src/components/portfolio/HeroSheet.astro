---
import Sheet from './Sheet.astro';

const links = [
  { label: 'Näin työskentelen', href: '#nain-tyoskentelen' },
  { label: 'Työnäytteet', href: '#tyonaytteet' },
  { label: 'Tutustutaan', href: '#tutustutaan' },
  { label: 'Ota yhteyttä', href: '#ota-yhteytta' },
];
---

<nav class="tabs" aria-label="Päävalikko" data-scrollspy>
  <a href="#alkuun" class="tabs__brand" aria-label="Titiu Rajanto – alkuun"><img src="/img/tiu-logo.svg" alt="Titiu Rajanto" width="40" height="40" /></a>
  <ul>
    <li><a href="#alkuun" class="is-active" aria-current="location">Alkuun</a></li>
    {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
  </ul>
</nav>

<Sheet label="Portfolio" id="alkuun">

  <div class="hero">
    <div class="hero__title">
      <p class="label hero__hello"><span class="hero__hello-text">Heips! Olen</span></p>
      <h1 class="display hero__name"><a href="#tutustutaan"><span class="hero__first">Titiu</span><br />Rajanto.</a></h1>
    </div>
    <div class="hero__side">
      <p class="label">UI/UX-suunnittelija ja front-end-kehittäjä</p>
      <p class="hero__lead">
        Suunnittelen hyviksi todetuilla käyttöliittymämalleilla, prototypoin HTML:llä ja CSS:llä ja rakennan nopeammin
        tekoälyavusteisella kehityksellä.
      </p>
      <a href="#tyonaytteet" class="hero__link">Katso työnäytteet ⟶</a>
    </div>
  </div>
</Sheet>

<style>
  /* Sticky top bar. Sits above the hero sheet, overlapping the page gap
     (32px) plus 1px so the two borders merge into one line. */
  .tabs {
    position: sticky;
    top: 0;
    z-index: 10;
    margin-bottom: -33px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px var(--pad) 16px calc(var(--rail) + var(--pad));
    background: var(--paper);
    border: var(--line);
    font-size: 16px;
  }
  .tabs a { text-decoration: none; }
  .tabs a:hover { color: var(--plum); }
  .tabs__brand { display: flex; align-items: center; }
  .tabs__brand img { display: block; width: 40px; height: 40px; }
  .tabs ul { display: flex; gap: 48px; }
  .tabs .is-active {
    font-weight: 700;
    color: var(--plum);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding: 160px var(--pad) 48px;
  }
  /* The script scales this so the text is exactly as wide as "Titiu" below it;
     the clamp() is the fallback before fonts load or without JS */
  .hero__hello {
    font-size: clamp(20px, 2.2vw, 32px);
    letter-spacing: 0.14em;
    line-height: 1.1;
    color: var(--plum);
    margin-bottom: 12px;
    white-space: nowrap;
  }
  /* Cancel the letter-spacing after the last letter so the measured width is the visible width */
  .hero__hello-text { margin-right: -0.14em; }
  .hero__name {
    font-size: clamp(56px, 10.5vw, 150px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--orange);
  }
  .hero__name a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .hero__name a:hover,
  .hero__name a:focus-visible { color: var(--plum); }
  .hero__side {
    width: 400px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 12px;
  }
  .hero__side .label { font-size: 19px; letter-spacing: 0.06em; }
  .hero__lead { font-size: 19px; line-height: 29px; }
  .hero__link {
    font-size: 16px;
    font-weight: 700;
    color: var(--plum);
    text-decoration: none;
  }
  .hero__link:hover { text-decoration: underline; }

  @media (max-width: 1100px) {
    .tabs ul { gap: 24px; }
  }
  /* Side-by-side layout: the name must leave room for the 400px side column,
     or "Rajanto." no longer fits on one line */
  @media (min-width: 1241px) {
    .hero__name { font-size: min(8.8vw, 140px); }
  }
  @media (max-width: 1240px) {
    .hero { flex-direction: column; align-items: flex-start; padding-top: 96px; }
    .hero__side { width: 100%; max-width: 560px; }
  }
  @media (max-width: 900px) {
    .tabs {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: 10px var(--pad) 4px;
    }
    .tabs__brand img { width: 36px; height: 36px; }
    /* All links stay visible: they wrap onto a second row instead of scrolling off-screen */
    .tabs ul { flex-wrap: wrap; column-gap: 18px; row-gap: 0; }
    .tabs ul a { display: inline-block; padding: 8px 0; white-space: nowrap; }
    .hero__link { display: inline-block; padding: 10px 0; }
    .hero {
      flex-direction: column;
      align-items: flex-start;
      padding: 56px var(--pad) 32px;
      gap: 32px;
    }
    .hero__side { width: 100%; }
    /* The sticky nav overlaps this sheet's top border, so give the "Portfolio" label bar more room above it */
    :global(#alkuun > .sheet__rail) { padding-top: 22px; padding-bottom: 14px; }
  }
  @media (max-width: 380px) {
    .hero__name { font-size: 14vw; }
  }
</style>

<script>
  // Size "Heips! Olen" so it is exactly as wide as "Titiu". Width scales linearly with
  // font-size (letter-spacing is in em), so one measurement is enough.
  const hello = document.querySelector<HTMLElement>('.hero__hello');
  const helloText = document.querySelector<HTMLElement>('.hero__hello-text');
  const first = document.querySelector<HTMLElement>('.hero__first');
  if (hello && helloText && first) {
    const fitHello = () => {
      hello.style.fontSize = '';
      const target = first.getBoundingClientRect().width;
      const current = helloText.getBoundingClientRect().width;
      if (!target || !current) return;
      const size = parseFloat(getComputedStyle(hello).fontSize);
      hello.style.fontSize = `${(size * target) / current}px`;
    };
    fitHello();
    document.fonts?.ready.then(fitHello);
    // Observe the block-level h1: ResizeObserver does not report inline elements
    new ResizeObserver(fitHello).observe(first.closest("h1") ?? first);
  }

  // Scrollspy: highlight the nav link of the section currently under the
  // sticky nav (same logic as titiu.com, without jQuery).
  const nav = document.querySelector<HTMLElement>('[data-scrollspy]');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('ul a[href^="#"]')];
    const sections = links
      .map((a) => document.getElementById(a.hash.slice(1)))
      .filter((el): el is HTMLElement => el !== null);

    let navHeight = 0;
    const measure = () => {
      navHeight = nav.offsetHeight;
      document.documentElement.style.setProperty('--nav-h', `${navHeight}px`);
    };

    let currentId = '';
    const update = () => {
      // Sections have a 16px scroll-margin, so count them active slightly early
      const line = navHeight + 24;
      let id = sections[0]?.id ?? '';
      for (const s of sections) {
        if (s.getBoundingClientRect().top <= line) id = s.id;
      }
      // At the very bottom of the page, activate the last link
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 5;
      if (atBottom && sections.length) id = sections[sections.length - 1].id;

      if (id === currentId) return;
      currentId = id;
      for (const a of links) {
        const active = a.hash === `#${id}`;
        a.classList.toggle('is-active', active);
        if (active) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    measure();
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      update();
    });
  }
</script>
