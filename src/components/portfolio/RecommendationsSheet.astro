---
import Sheet from './Sheet.astro';
import { recommendations } from '../../data/recommendations';

const linkedInUrl = 'https://www.linkedin.com/in/titiu/details/recommendations/';
---

<Sheet label="Suositukset" id="suositukset">
  <div class="recs__head">
    <h2 class="display recs__title">Suositukset</h2>
  </div>

  <ul class="recs">
    {recommendations.map((r) => (
      <li class="rec">
        <div class="rec__inner">
          <div class="rec__face rec__face--front">
            <span class="rec__mark" aria-hidden="true">”</span>
            <blockquote class="rec__quote"><p>{r.quote}</p></blockquote>
            <div class="rec__person">
              <img src={r.photo} alt="" width="72" height="72" loading="lazy" decoding="async" />
              <div>
                <p class="rec__name">{r.name}</p>
                <p class="rec__role">{r.role}</p>
                {r.then && <p class="rec__role">{r.then}</p>}
              </div>
            </div>
          </div>
          <div class="rec__face rec__face--back">
            <span class="rec__mark" aria-hidden="true">”</span>
            <blockquote class="rec__quote">{r.back.quote.map((t) => <p>{t}</p>)}</blockquote>
            <div class="rec__person">
              <img src={r.back.photo} alt="" width="72" height="72" loading="lazy" decoding="async" />
              <div>
                <p class="rec__name">{r.back.name}</p>
                <p class="rec__role">{r.back.role}</p>
                {r.back.then && <p class="rec__role">{r.back.then}</p>}
              </div>
            </div>
          </div>
        </div>
        <button type="button" class="rec__flip" aria-pressed="false">
          Käännä<span class="visually-hidden"> kortti: näytä suositus, jonka antaja on {r.back.name}</span>
          <span aria-hidden="true">↻</span>
        </button>
      </li>
    ))}
  </ul>

  <a href={linkedInUrl} target="_blank" rel="noopener" class="recs__more">
    <span>Lue lisää suosituksia LinkedInistä</span>
    <span class="circle" aria-hidden="true">↗</span>
  </a>
</Sheet>

<script>
  // Flip cards: hover flips on mouse devices (CSS). Tapping the card (touch) or the
  // "Käännä" button (keyboard / touch) toggles .is-flipped.
  const noHover = window.matchMedia('(hover: none)');
  document.querySelectorAll<HTMLElement>('.rec').forEach((card) => {
    const button = card.querySelector<HTMLButtonElement>('.rec__flip');
    card.addEventListener('click', (e) => {
      const onButton = !!(e.target as HTMLElement).closest('.rec__flip');
      if (!onButton && !noHover.matches) return;
      const flipped = card.classList.toggle('is-flipped');
      button?.setAttribute('aria-pressed', String(flipped));
    });
  });
</script>

<style>
  .recs__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 40px var(--pad);
    border-bottom: var(--line);
  }
  .recs__title { font-size: 64px; }

  .recs { display: grid; grid-template-columns: 1fr 1fr; }
  .rec {
    position: relative;
    display: flex;
    border-bottom: var(--line);
    perspective: 1800px;
  }
  .rec:nth-child(odd) { border-right: var(--line); }

  /* Both faces share one grid cell, so the card is as tall as the longer quote */
  .rec__inner {
    flex-grow: 1;
    display: grid;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .rec.is-flipped .rec__inner { transform: rotateY(180deg); }
  @media (hover: hover) and (pointer: fine) {
    .rec:hover .rec__inner { transform: rotateY(180deg); }
  }

  .rec__face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 40px var(--pad) 32px;
    background: var(--paper);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .rec__face--back {
    transform: rotateY(180deg);
    background: var(--plum);
    color: var(--paper);
  }

  .rec__mark {
    font-family: var(--font-display);
    font-size: 96px;
    line-height: 0.6;
    height: 40px;
    color: inherit;
  }
  .rec__quote {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    font-size: 18px;
    line-height: 29px;
    max-width: 560px;
    flex-grow: 1;
  }
  .rec__person {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px dashed var(--ink);
  }
  .rec__person img {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1);
  }
  .rec__name { font-weight: 800; }
  .rec__role { font-size: 16px; line-height: 22px; color: var(--muted); }
  .rec__face--back .rec__person { border-top-color: var(--plum-soft); }
  .rec__face--back .rec__role { color: var(--plum-soft); }


  /* Flip button: a visible hint on touch screens; on mouse devices only shown to keyboard users */
  .rec__flip {
    position: absolute;
    top: 28px;
    right: var(--pad);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font: inherit;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    background: var(--paper);
    border: var(--line);
    border-radius: 999px;
    cursor: pointer;
  }
  .rec__flip:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) {
    .rec__flip:not(:focus-visible) {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
  }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .rec__inner { transition: none; }
  }

  .recs__more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px var(--pad);
    font-family: var(--font-display);
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .recs__more:hover { color: var(--plum); }

  @media (max-width: 900px) {
    .recs__head { flex-direction: column; align-items: flex-start; padding: 32px var(--pad); gap: 8px; }
    .recs__title { font-size: 40px; }
    .recs { grid-template-columns: 1fr; }
    .rec:nth-child(odd) { border-right: none; }
    .rec__face { padding: 32px var(--pad) 24px; gap: 24px; }
    .rec__flip { top: 22px; padding: 9px 14px; }
    .rec__quote { font-size: 16px; line-height: 26px; }
    .rec__person img { width: 56px; height: 56px; }
    .recs__more { font-size: 16px; }
  }
  @media (max-width: 380px) {
    .recs__title { font-size: 11vw; }
  }
</style>
