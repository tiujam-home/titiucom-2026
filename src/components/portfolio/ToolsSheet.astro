---
import Sheet from './Sheet.astro';

const groups = [
  {
    title: 'Suunnittelu',
    tools: ['Adobe Suite', 'Käyttöliittymämallit', 'Prototypointi', 'Graafinen suunnittelu', 'Palvelumuotoilu ja CX', 'Paper', 'Figma', 'Tuotemuotoilu', 'Painotuotteet', 'Brändistrategia', 'Sisustussuunnittelu'],
    growing: ['Työpajojen fasilitointi'],
  },
  {
    title: 'Kehitys',
    tools: ['Tekoälyavusteinen kehitys', 'Claude Code', 'HTML5', 'CSS3/SASS/LESS', 'Bootstrap 5.3', 'Astro', 'Wordpress', 'Verkkostandardit', 'Visual Studio', 'VS Code'],
    growing: ['JavaScript'],
  },
  {
    title: 'Johtaminen',
    tools: ['Avainasiakkuuksien hoito', 'Projektijohtaminen', 'Google Workspace', 'MS Office', 'Dokumentointi', 'Tiedonhallinta', 'Kirjanpito', 'Mentorointi'],
    growing: ['Liiketoimintastrategia'],
  },
];
---

<Sheet label="Näin työskentelen">
  <div class="tools__head">
    <h2 class="display tools__title"><span aria-hidden="true">↶</span>Lempityökaluni<span aria-hidden="true">↷</span></h2>
  </div>
  <div class="tools">
    {groups.map((g) => (
      <div class="tools__col">
        <div class="tools__top">
          <div class="tools__colhead">
            <h3 class="display">{g.title}</h3>
          </div>
          <ul class="pills">
            {g.tools.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="tools__growing">
          <p class="label">Kehittyvät taidot</p>
          <ul class="pills pills--growing">
            {g.growing.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </div>
    ))}
  </div>
</Sheet>

<style>
  .tools__head { padding: 40px var(--pad); border-bottom: var(--line); }
  .tools__title { font-size: 64px; text-align: center; }
  .tools__title span { color: var(--plum); }
  .tools { display: grid; grid-template-columns: repeat(3, 1fr); }
  .tools__col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding: var(--pad);
    border-right: var(--line);
    text-align: center;
  }
  .tools__col:last-child { border-right: none; }
  .tools__top { display: flex; flex-direction: column; gap: 20px; }
  .tools__colhead h3 { font-size: 30px; letter-spacing: 0; }
  .pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .pills li {
    font-size: 16px;
    line-height: 1.2;
    padding: 7px 14px;
    border: var(--line);
    border-radius: 999px;
  }
  .pills--growing li { background: var(--plum); border-color: var(--plum); color: var(--paper); font-weight: 600; }
  .tools__growing {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px dashed var(--ink);
  }
  .tools__growing .label { color: var(--plum); }

  @media (max-width: 1100px) {
    .tools__title { font-size: 48px; }
  }
  @media (max-width: 900px) {
    .tools__head { padding: 32px var(--pad); }
    .tools__title { font-size: clamp(26px, 8vw, 34px); }
    .tools__title span { display: none; }
    .tools { grid-template-columns: 1fr; }
    .tools__col { border-right: none; border-bottom: var(--line); }
    .tools__col:last-child { border-bottom: none; }
    .tools__colhead h3 { font-size: 24px; }
  }
</style>
