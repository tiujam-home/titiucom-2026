---
import Sheet from './Sheet.astro';

const facts = [
  { term: 'Sijainti', text: 'Etelä-Suomi, Lohja' },
  { term: 'Perhe', text: 'Mies ja tytär' },
  {
    term: 'Harras­tukset', // ­ = &shy;
    text: 'Podcastien kuuntelu tuplanopeudella, kirjojen ahmiminen, flirttailu biohakkeroinnin kanssa, vaeltaminen, puutarhanhoito, videopelit ja kaikenlaiset tee-se-itse-projektit.',
  },
  {
    term: 'Luonne',
    text: 'Nauru ja hymy irtoavat minulta tosi helposti. Toisaalta olen luonteeltani kriittinen ajattelija ja mietin uusien ideoiden käytännön seurauksia. Olen myös allerginen draamalle, mutta suora viestintä on osoittautunut täydelliseksi vastalääkkeeksi. Pärjään mielestäni paineen alla ihailtavasti, ja minut tunnetaan siitä, että pidän tiimikavereideni päät pinnalla itsepäisen sinnikkyyden ja huonojen vitsien yhdistelmällä.',
  },
];

const links = [
  {
    title: 'Verkostoidu kanssani LinkedInissä.',
    text: 'Lue, mitä entiset työkaverini sanovat yhteistyöstä kanssani, ja verkostoidu samalla.',
    href: 'https://www.linkedin.com/', // TODO: your LinkedIn profile URL
    icon: '↗',
    external: true,
  },
  {
    title: 'Lataa ansioluetteloni.',
    text: 'Suosin ansioluettelossakin verkon joustavuutta, mutta jos olet PDF-ihmisiä, tämä on varsinainen koukuttava lukuelämys ;)',
    href: '/titiu-rajanto-cv.pdf', // TODO: put the PDF in the public folder
    icon: '↓',
    featured: true,
  },
  {
    title: 'Katso omat tee-se-itse-projektini.',
    text: 'Jotain puuseppä-isoisältäni on selvästi tarttunut, sillä olen aina tykännyt näprätä fyysisten asioiden parissa bittien ja pikselien lisäksi. Vasara käteen.',
    href: '#', // TODO: DIY projects page
    icon: '→',
  },
];
---

<Sheet label="Tutustutaan" id="tutustutaan">
  <div class="about__head">
    <h2 class="display about__title">Tutustutaan</h2>
    <p class="about__aside">Minä tiivistettynä</p>
  </div>

  <div class="about">
    <dl class="facts">
      {facts.map((f) => (
        <div class="facts__row">
          <dt class="label">{f.term}</dt>
          <dd>{f.text}</dd>
        </div>
      ))}
      <div class="facts__row facts__row--featured">
        <dt class="label">Erikoi&shy;suudet</dt>
        <dd>Yksi lempijälkiruoistani on sitkeä ruisleipä juuston ja banaaniviipaleiden kera.</dd>
      </div>
    </dl>

    <div class="story">
      <h3 class="label">Miten päädyin tänne?</h3>
      <p>
        Kun olin liian nuori tietääkseni paremmin, halusin näyttelijäksi. Tavoittelin tätä unelmaa
        iloisesti 15-vuotiaaksi asti, kunnes näin Jurassic Parkin elokuvateatterissa isäni kanssa.
        Sen lisäksi, että velociraptorit pelottivat minut puolikuoliaaksi, häikäistyin valkokankaan
        digitaalisen todellisuuden kauneudesta. Lopputekstien alkaessa tiesin, että halusin nimeni
        otsikon ”Special Effects” alle enkä otsikon ”Cast” alle.
      </p>
      <p class="display story__pull">Ja katso: näin astui muotoilu elämääni.</p>
      <p>
        Tämä onnekas sattuma vei minut uudelle polulle, joka on johtanut ammattiin. Olen tehnyt sitä
        yli 20 vuotta, ja se on yhä lähellä sydäntäni.
      </p>
      <p>
        Osaamiseni pohjautuu graafiseen suunnitteluun, josta se laajeni käyttöliittymäsuunnitteluun
        ja front-end-kehitykseen. Myöhemmin Bed &amp; Breakfastin vetäjänä pääsin soveltamaan
        UX-taitojani fyysiseen maailmaan.
      </p>
      <p>
        Kaikki edellä mainittu yhdistyy palvelumuotoilussa. Kokemukseni ansiosta olen voinut
        suunnitella sekä digitaalisia palveluja että fyysisiä tiloja, jotka palvelevat käyttäjiään
        parhaalla mahdollisella tavalla.
      </p>
    </div>
  </div>

  <div class="more__intro">
    <p class="label">Lisää minusta</p>
    <p>
      Olen viime vuosina ollut aivan liian kiireinen luomaan ja tekemään, joten verkkonäkyvyyteni
      rakentaminen on jäänyt jälkeen. Muutan tätä parhaillaan, mutta toistaiseksi parhaat tavat
      tutustua minuun ovat nämä:
    </p>
  </div>
  <ul class="more">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          class:list={['more__card', { 'more__card--featured': l.featured }]}
          {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          <span class="more__text">
            <span class="display more__title">{l.title}</span>
            <span class="more__desc">{l.text}</span>
          </span>
          <span class:list={['circle', { 'circle--filled': l.featured }]} aria-hidden="true">{l.icon}</span>
        </a>
      </li>
    ))}
  </ul>
</Sheet>

<style>
  .about__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 40px var(--pad);
    border-bottom: var(--line);
  }
  .about__title { font-size: 64px; }
  .about__aside { font-weight: 500; }

  .about { display: flex; border-bottom: var(--line); }
  .facts {
    width: 560px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: var(--line);
  }
  .facts__row {
    display: flex;
    gap: 24px;
    padding: 20px var(--pad);
    border-bottom: var(--line);
    line-height: 24px;
  }
  .facts__row dt { width: 120px; flex-shrink: 0; padding-top: 4px; }
  .facts__row--featured {
    flex-grow: 1;
    border-bottom: none;
    background: var(--plum);
    color: var(--paper);
  }

  .story {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px var(--pad) 40px;
    line-height: 25px;
  }
  .story > * { max-width: 620px; }
  .story__pull {
    font-size: 40px;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--plum);
    padding: 12px 0;
  }

  .more__intro {
    display: flex;
    gap: 24px;
    padding: 28px var(--pad);
    border-bottom: var(--line);
    line-height: 25px;
  }
  .more__intro .label { width: 120px; flex-shrink: 0; padding-top: 4px; }
  .more__intro p:last-child { max-width: 760px; }

  .more { display: grid; grid-template-columns: repeat(3, 1fr); }
  .more li { border-right: var(--line); }
  .more li:last-child { border-right: none; }
  .more__card {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 28px var(--pad);
    text-decoration: none;
  }
  .more__text { display: flex; flex-direction: column; gap: 12px; }
  .more__title { font-size: 26px; letter-spacing: -0.01em; line-height: 1.08; }
  .more__desc { font-size: 16px; line-height: 22px; color: var(--muted); }
  .more__card--featured { background: var(--plum); color: var(--paper); }
  .more__card--featured .more__desc { color: var(--plum-soft); }

  @media (max-width: 1100px) {
    .facts { width: 440px; }
  }
  @media (max-width: 900px) {
    .about__head { flex-direction: column; align-items: flex-start; padding: 32px var(--pad); gap: 8px; }
    .about__title { font-size: 40px; }
    .about { flex-direction: column; }
    .facts { width: auto; border-right: none; border-bottom: var(--line); }
    .facts__row { flex-direction: column; gap: 6px; }
    .facts__row dt { width: auto; padding-top: 0; }
    .story__pull { font-size: 30px; }
    .more__intro { flex-direction: column; gap: 8px; }
    .more { grid-template-columns: 1fr; }
    .more li { border-right: none; border-bottom: var(--line); }
    .more li:last-child { border-bottom: none; }
  }
</style>
